  fonts:
    # Arabic UI typeface. This font family provides the Arabic glyphs and UI metrics.
    - family: NotoSansArabicUI
      fonts:
        - asset: assets/fonts/NotoSansArabicUI-Regular.ttf
          weight: 400
        - asset: assets/fonts/NotoSansArabicUI-Bold.ttf
          weight: 700
    # Script fallback for Latin text (BUY/SELL, symbols, ticker codes and abbreviations).
    # It keeps multilingual text consistent and avoids platform-dependent system fonts.
    - family: NotoSans
      fonts:
        - asset: assets/fonts/NotoSans-Regular.ttf
          weight: 400
        - asset: assets/fonts/NotoSans-Medium.ttf
          weight: 500
        - asset: assets/fonts/NotoSans-SemiBold.ttf
          weight: 600
        - asset: assets/fonts/NotoSans-Bold.ttf
          weight: 700
